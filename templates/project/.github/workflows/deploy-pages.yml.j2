# GitHub Pages deployment for {{ repo }} (generated by auto-pi, Milestone 4 / plan.md §12.3).
#
# On every push to `main` (and on manual dispatch), builds the Vite app (which
# uses `base: "/{{ repo }}/"` so assets resolve under the Pages sub-path) and
# publishes it via the official Pages actions. The `pages` and `id-token`
# permissions are required by `actions/configure-pages` / `actions/deploy-pages`,
# and the `concurrency` group keeps only the latest deployment running.

name: Deploy to GitHub Pages

on:
  push:
    branches: [ main ]
  workflow_dispatch:

# Required by the official Pages actions.
permissions:
  contents: read
  pages: write
  id-token: write

# Allow only one concurrent deployment, cancelling in-progress runs.
concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - name: Install dependencies
        run: npm ci

      - name: Build
        run: npm run build

      - name: Configure Pages
        uses: actions/configure-pages@v5

      - name: Upload Pages artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4
