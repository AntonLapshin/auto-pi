{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://auto-pi.dev/schemas/config.schema.json",
  "title": "auto-pi project configuration",
  "description": "Schema for the auto-pi project config (config.default.json and generated {project}/.pi/config.json). Validation used by the harness (M13) and by generated projects.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "project": {
      "type": "object",
      "default": {},
      "properties": {
        "name": { "type": "string", "default": "" },
        "repo": { "type": "string", "default": "" },
        "owner": { "type": "string", "default": "" },
        "ownerEmail": { "type": "string", "format": "email", "default": "" },
        "defaultBranch": { "type": "string", "default": "main" },
        "demoUrl": { "type": "string", "format": "uri", "default": "" }
      }
    },
    "pi": {
      "type": "object",
      "default": {},
      "properties": {
        "model": { "type": "string" },
        "provider": { "type": "string" },
        "contextMaxTokens": { "type": "integer", "minimum": 0, "default": 0, "description": "Model context window. 0 = unlimited (no cap)." },
        "maxRetries": { "type": "integer", "minimum": 0, "default": 2, "description": "Retries (in addition to the first attempt) for a transient persona/LLM invocation failure (M13)." },
        "retryBaseDelayMs": { "type": "integer", "minimum": 0, "default": 5000, "description": "Base backoff delay (ms) between persona retries; doubles per retry (M13)." },
        "retryMaxDelayMs": { "type": "integer", "minimum": 0, "default": 30000, "description": "Maximum backoff delay (ms) between persona retries (M13)." }
      }
    },
    "loop": {
      "type": "object",
      "default": {},
      "properties": {
        "intervalSeconds": { "type": "integer", "minimum": 5, "default": 60 },
        "stopOnBudgetExceeded": { "type": "boolean", "default": true },
        "maxConsecutiveFailures": { "type": "integer", "minimum": 1, "default": 3 },
        "personaInactivityMs": { "type": "integer", "minimum": 0, "default": 600000,
          "description": "Persona inactivity timeout in ms (default 10 min). If a persona emits no output for this long it is considered hung and is killed + retried instead of stalling the loop. 0 disables." },
        "personaTimeoutMs": { "type": "integer", "minimum": 0, "default": 3600000,
          "description": "Hard wall-clock cap in ms for a single persona session (default 60 min). Backstop for hangs that defeat inactivity detection (slow trickle of output while never progressing); guarantees the loop can never be blocked on one persona longer than this. 0 disables." }
      }
    },
    "limits": {
      "type": "object",
      "default": {},
      "properties": {
        "maxBatchIssues": { "type": "integer", "minimum": 1, "default": 3 },
        "maxIssueAttempts": { "type": "integer", "minimum": 1, "default": 3 },
        "maxTokensPerCycle": { "type": "integer", "minimum": 0, "default": 0, "description": "Max tokens per loop cycle. 0 = unlimited." },
        "maxTokensPerDay": { "type": "integer", "minimum": 0, "default": 0, "description": "Max tokens per day. 0 = unlimited." },
        "maxCostPerDayUsd": { "type": "number", "minimum": 0, "default": 0, "description": "Max per-day cost in USD. 0 = unlimited." },
        "maxPromptTokensPerPersona": { "type": "integer", "minimum": 0, "default": 0, "description": "Max prompt tokens per persona. 0 = unlimited." },
        "maxOutputTokensPerPersona": { "type": "integer", "minimum": 0, "default": 0, "description": "Max output tokens per persona. 0 = unlimited." }
      }
    },
    "github": {
      "type": "object",
      "default": {},
      "properties": {
        "autoCreateRepo": { "type": "boolean", "default": true },
        "repoVisibility": { "type": "string", "enum": ["public", "private"], "default": "public" }
      }
    },
    "stack": {
      "type": "object",
      "default": {},
      "properties": {
        "framework": { "type": "string", "enum": ["react"], "default": "react" },
        "typescript": { "type": "boolean", "default": true },
        "tailwind": { "type": "boolean", "default": true },
        "testRunner": { "type": "string", "enum": ["vitest"], "default": "vitest" }
      }
    },
    "quality": {
      "type": "object",
      "default": {},
      "properties": {
        "coreCoveragePercent": { "type": "integer", "minimum": 0, "maximum": 100, "default": 100 },
        "featureBranches": { "type": "boolean", "default": true }
      }
    },
    "review": {
      "type": "object",
      "default": {},
      "description": "Review Engineer settings (M9, plan.md §18.5).",
      "properties": {
        "reviewerCanPushTestCommits": {
          "type": "boolean",
          "default": false,
          "description": "Whether the Review Engineer may push test commits to PR branches. Default false — reviewers request changes / open follow-up issues instead (role separation)."
        }
      }
    },
    "pages": {
      "type": "object",
      "default": {},
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "deployBranch": { "type": "string", "default": "gh-pages" }
      }
    },
    "notifications": {
      "type": "object",
      "default": {},
      "properties": {
        "telegram": {
          "type": "object",
          "default": {},
          "description": "M11 / plan.md §24 — optional env-driven Telegram lifecycle notifications. No-op when disabled or when the env vars are absent.",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "botTokenEnv": { "type": "string", "default": "TELEGRAM_BOT_TOKEN" },
            "chatIdEnv": { "type": "string", "default": "TELEGRAM_CHAT_ID" },
            "notifyOnDone": { "type": "boolean", "default": true },
            "notifyOnStopped": { "type": "boolean", "default": true },
            "notifyOnNeedsHuman": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "default": {},
      "properties": {
        "maxFileSizeMb": { "type": "integer", "minimum": 1, "default": 10 },
        "rotate": { "type": "boolean", "default": true }
      }
    }
  }
}
